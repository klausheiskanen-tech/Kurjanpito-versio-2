from flask import Flask, render_template, request, redirect, url_for, flash, send_from_directory
from flask_login import LoginManager, UserMixin, login_user, login_required, logout_user
from werkzeug.security import generate_password_hash, check_password_hash
import sqlite3
import os

app = Flask(__name__)
app.secret_key = "kirjanpito_salainen_avain_2025"

login_manager = LoginManager()
login_manager.init_app(app)
login_manager.login_view = "kirjaudu"

class Kayttaja(UserMixin):
    def __init__(self, id, tunnus):
        self.id = id
        self.tunnus = tunnus

@login_manager.user_loader
def load_user(user_id):
    yhteys = get_db()
    kayttaja = yhteys.execute("SELECT * FROM kayttajat WHERE id = ?", (user_id,)).fetchone()
    yhteys.close()
    if kayttaja:
        return Kayttaja(kayttaja["id"], kayttaja["tunnus"])
    return None

import os
from werkzeug.utils import secure_filename

UPLOAD_FOLDER = 'static/liitteet'
SALLITUT_TYYPIT = {'pdf', 'png', 'jpg', 'jpeg'}

def sallittu_tiedosto(nimi):
    return '.' in nimi and nimi.rsplit('.', 1)[1].lower() in SALLITUT_TYYPIT

def get_db():
    yhteys = sqlite3.connect("kirjanpito.db")
    yhteys.row_factory = sqlite3.Row
    return yhteys

def muuta_summa(arvo):
    return float(str(arvo).replace(",", "."))

def muuta_paivamaara(pvm):
    pvm = pvm.strip()
    for erotin in [".", "/"]:
        if erotin in pvm:
            osat = pvm.split(erotin)
            if len(osat) == 3 and len(osat[2]) == 4:
                return f"{osat[2]}-{osat[1].zfill(2)}-{osat[0].zfill(2)}"
    return pvm

def nayta_paivamaara(pvm):
    if pvm and len(pvm) == 10 and pvm[4] == "-":
        return f"{pvm[8:10]}.{pvm[5:7]}.{pvm[0:4]}"
    return pvm

def luo_tietokanta():
    yhteys = get_db()
    kursori = yhteys.cursor()
    kursori.execute("""
        CREATE TABLE IF NOT EXISTS asetukset (
            id INTEGER PRIMARY KEY,
            yritys_nimi TEXT,
            ytunnus TEXT,
            osoite TEXT,
            postiosoite TEXT,
            puhelin TEXT,
            tyontekija_nimi TEXT,
            tyontekija_osoite TEXT,
            tyontekija_postiosoite TEXT,
            verotuskunta TEXT,
            nimike TEXT,
            tyosuhde_alkoi TEXT,
            hetu TEXT,
            iban TEXT,
            bic TEXT
        )
    """)

    kursori.execute("""
        CREATE TABLE IF NOT EXISTS verokortti (
            id INTEGER PRIMARY KEY,
            perus_pros TEXT,
            lisa_pros TEXT,
            tuloraja TEXT,
            sotumaksu TEXT
        )
    """)
    kursori.execute("""
        CREATE TABLE IF NOT EXISTS kayttajat (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            tunnus TEXT UNIQUE NOT NULL,
            salasana TEXT NOT NULL
        )
    """)

    kursori.execute("""
        CREATE TABLE IF NOT EXISTS tilit (
            numero TEXT PRIMARY KEY,
            nimi TEXT NOT NULL,
            tyyppi TEXT NOT NULL
        )
    """)

    kursori.execute("""
        CREATE TABLE IF NOT EXISTS tositteet (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            paivamaara TEXT NOT NULL,
            kuvaus TEXT NOT NULL
        )
    """)

    kursori.execute("""
        CREATE TABLE IF NOT EXISTS tapahtumat (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            tosite_id INTEGER NOT NULL,
            tili_numero TEXT NOT NULL,
            debet REAL DEFAULT 0,
            kredit REAL DEFAULT 0,
            alv_prosentti REAL DEFAULT 0,
